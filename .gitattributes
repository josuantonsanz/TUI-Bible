# Normalize source text to LF in the repository so the tree is identical on
# every platform.
* text=auto eol=lf

# Bundled datasets are fixed third-party artifacts. Keep them byte-for-byte
# (no end-of-line conversion) and out of diffs, line counts, and GitHub
# language statistics.
startup/*.csv -text -diff linguist-generated
startup/*.json -text -diff linguist-generated
startup/*.pk -text -diff linguist-generated
opengnt_interface/data/parallels.json -diff linguist-generated
uv.lock -diff linguist-generated

# Windows launchers must keep CRLF line endings to run reliably in cmd.exe.
*.cmd text eol=crlf
*.bat text eol=crlf
